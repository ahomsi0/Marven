{
  "name": "marven-repo",
  "private": true,
  "description": "Marven desktop app (apps/desktop) and website (apps/website). Each app has its own dependencies; these scripts only forward to them.",
  "scripts": {
    "desktop": "npm --prefix apps/desktop run electron:dev",
    "desktop:test": "npm --prefix apps/desktop test",
    "desktop:build": "npm --prefix apps/desktop run electron:build",
    "website": "npm --prefix apps/website run dev",
    "website:test": "npm --prefix apps/website test",
    "website:build": "npm --prefix apps/website run build"
  }
}
